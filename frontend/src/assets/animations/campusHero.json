{
  "name": "Campus marketplace floating cards",
  "duration": 3,
  "loop": true,
  "sceneClass": "rounded-3xl",
  "elements": [
    {
      "type": "circle",
      "className": "absolute left-8 top-8 h-20 w-20 rounded-full bg-orange-400/90 blur-sm",
      "initial": { "y": 0, "scale": 0.9 },
      "animate": { "y": [0, -16, 0], "scale": [0.9, 1.05, 0.9] },
      "transition": { "duration": 4, "repeat": null, "ease": "easeInOut" }
    },
    {
      "type": "circle",
      "className": "absolute bottom-10 right-10 h-24 w-24 rounded-full bg-blue-500/90 blur-sm",
      "initial": { "y": 0, "scale": 1 },
      "animate": { "y": [0, 18, 0], "scale": [1, 0.86, 1] },
      "transition": { "duration": 4.6, "repeat": null, "ease": "easeInOut" }
    },
    {
      "type": "card",
      "className": "absolute left-10 top-24 rounded-2xl border border-white/70 bg-white/95 px-5 py-4 shadow-soft",
      "initial": { "x": -20, "opacity": 0 },
      "animate": { "x": [0, 10, 0], "opacity": 1 },
      "transition": { "duration": 3.8, "repeat": null, "ease": "easeInOut" },
      "content": "Books"
    },
    {
      "type": "card",
      "className": "absolute right-8 top-28 rounded-2xl border border-white/70 bg-white/95 px-5 py-4 shadow-soft",
      "initial": { "x": 20, "opacity": 0 },
      "animate": { "x": [0, -10, 0], "opacity": 1 },
      "transition": { "duration": 4.2, "repeat": null, "ease": "easeInOut" },
      "content": "Rooms"
    },
    {
      "type": "card",
      "className": "absolute bottom-24 left-1/3 rounded-2xl border border-white/70 bg-white/95 px-5 py-4 shadow-soft",
      "initial": { "y": 20, "opacity": 0 },
      "animate": { "y": [0, -12, 0], "opacity": 1 },
      "transition": { "duration": 4, "repeat": null, "ease": "easeInOut" },
      "content": "Chat"
    }
  ]
}
