    {
      "type": "bar",
      "className": "absolute bottom-14 left-4 h-4 w-1/2 rounded-full bg-slate-200",
      "animate": { "opacity": [0.3, 0.9, 0.3], "width": ["38%", "52%", "38%"] },
      "transition": { "duration": 1.35, "repeat": null, "ease": "easeInOut" }
    },
    {
      "type": "bar",
      "className": "absolute bottom-4 left-4 right-4 h-10 rounded-xl bg-slate-200",
      "animate": { "opacity": [0.5, 1, 0.5] },
      "transition": { "duration": 1.6, "repeat": null, "ease": "easeInOut" }
