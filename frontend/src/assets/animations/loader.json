    },
    {
      "type": "bar",
      "className": "absolute bottom-20 left-4 h-4 w-3/4 rounded-full bg-slate-200",
      "animate": { "opacity": [0.4, 1, 0.4], "width": ["60%", "78%", "60%"] },
      "transition": { "duration": 1.5, "repeat": null, "ease": "easeInOut" }
