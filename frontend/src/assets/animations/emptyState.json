      "transition": { "duration": 2.2, "repeat": null, "ease": "easeInOut" }
    },
    {
      "type": "circle",
      "className": "absolute right-20 top-20 h-10 w-10 rounded-full border-4 border-blue-500",
      "animate": { "rotate": [0, 20, 0], "scale": [1, 1.12, 1] },
